{
  "schema_version": "vidquery-model-profiles-v1",
  "description": "Experimental indexing profiles for the 26 Oct 2026 integrated evaluation. Applied as environment overrides by scripts/run_with_profile.py; the production .env and code defaults are not changed.",
  "common": {
    "WHISPER_TEMPERATURE_FALLBACK": "false",
    "ENABLE_GNN_ACTIONS": "true",
    "ENABLE_RELATION_GNN": "true",
    "ENABLE_NEO4J": "false",
    "HF_HUB_OFFLINE": "1"
  },
  "models": {
    "ava_v5": {
      "GNN_CHECKPOINT": "data/app/models/ava80_scaling/30/ablations/ava80-gat-v5-scale30-roi-frame.pt",
      "GNN_METADATA": "data/app/models/ava80_scaling/30/ablations/ava80-gat-v5-scale30-roi-frame.metadata.json",
      "GNN_MODEL_VERSION": "ava80-gat-v5-scale30-roi-frame"
    },
    "ava_v8": {
      "GNN_CHECKPOINT": "data/app/models/ava80_scale100/ava80-gat-v8-noleak-scale100-lr0.0003.pt",
      "GNN_METADATA": "data/app/models/ava80_scale100/ava80-gat-v8-noleak-scale100-lr0.0003.metadata.json",
      "GNN_MODEL_VERSION": "ava80-gat-v8-noleak-scale100-lr0.0003"
    },
    "vidor_v2": {
      "RELATION_GNN_CHECKPOINT": "data/app/models/vidor_relation_pair_visual/vidor-relation-pair-visual-gat-v2.pt",
      "RELATION_GNN_METADATA": "data/app/models/vidor_relation_pair_visual/vidor-relation-pair-visual-gat-v2.metadata.json",
      "RELATION_GNN_MODEL_VERSION": "vidor-relation-pair-visual-gat-v2"
    },
    "vidor_v4": {
      "RELATION_GNN_CHECKPOINT": "data/app/models/vidor_relation_scale2000/vidor-relation-pair-visual-gat-v4-scale2000.pt",
      "RELATION_GNN_METADATA": "data/app/models/vidor_relation_scale2000/vidor-relation-pair-visual-gat-v4-scale2000.metadata.json",
      "RELATION_GNN_MODEL_VERSION": "vidor-relation-pair-visual-gat-v4-scale2000"
    }
  },
  "profiles": {
    "det-ava5-vidor2": ["ava_v5", "vidor_v2"],
    "det-ava8-vidor2": ["ava_v8", "vidor_v2"],
    "det-ava5-vidor4": ["ava_v5", "vidor_v4"],
    "det-ava8-vidor4": ["ava_v8", "vidor_v4"]
  }
