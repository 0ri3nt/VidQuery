 "movie_dialogue_-IELREHX_js_990s": {
  "kind": "speech",
  "speaker_turns": 24,
  "speech_seconds_diarized": 42.0,
  "utterances_before": 19,
  "utterances_after": 19,
  "words_before": 202,
  "words_after": 202,
  "filter": {
   "applied": true,
   "speech_gate": "diarization",
   "kept": 19,
   "dropped": {}
  },
  "utterances": [
   {
    "start": 0.0,
    "end": 1.6,
    "speaker": "SPEAKER_00",
    "compression": 0.65,
    "kept": true,
    "text": "I'm very squat."
   },
   {
    "start": 2.44,
    "end": 6.88,
    "speaker": "SPEAKER_00",
    "compression": 1.07,
    "kept": true,
    "text": "I can still help you, but you have to stop all this crazy talk about being fitted out."
   },
   {
    "start": 7.06,
    "end": 8.32,
    "speaker": "SPEAKER_01",
    "compression": 0.74,
    "kept": true,
    "text": "Please, come to see me."
   },
   {
    "start": 9.58,
    "end": 12.04,
    "speaker": "SPEAKER_01",
    "compression": 1.02,
    "kept": true,
    "text": "I told him what you did to me. I've told him everything."
   },
   {
    "start": 12.6,
    "end": 15.56,
    "speaker": "SPEAKER_00",
    "compression": 0.89,
    "kept": true,
    "text": "Yes, and he didn't believe you, Major. I've spoken to him."
   },
   {
    "start": 16.56,
    "end": 18.84,
    "speaker": "SPEAKER_00",
    "compression": 0.85,
    "kept": true,
    "text": "He thought you were raven, and I can see why."
   },
   {
    "start": 19.28,
    "end": 24.66,
    "speaker": "SPEAKER_00",
    "compression": 1.08,
    "kept": true,
    "text": "I can get the charges down to Man's Law. You'll be at him two years, but you have to plead guilty."
   },
   {
    "start": 24.72,
    "end": 25.74,
    "speaker": "SPEAKER_00",
    "compression": 0.7,
    "kept": true,
    "text": "That fuck should I?"
   },
   {
    "start": 25.74,
    "end": 31.92,
    "speaker": "SPEAKER_00",
    "compression": 1.1,
    "kept": true,
    "text": "Because if you die, I shall have to put Kathy in the witness box, and I'll get her to testify against you."
   },
   {
    "start": 32.14,
    "end": 36.64,
    "speaker": "SPEAKER_00",
    "compression": 1.21,
    "kept": true,
    "text": "Is that what you want? You want your daughter to tell you the world what a lousy fucking mother you are?"
   },
   {
    "start": 36.82,
    "end": 38.5,
    "speaker": "SPEAKER_02",
    "compression": 0.85,
    "kept": true,
    "text": "Why are you so bothered about her?"
   },
   {
    "start": 39.32,
    "end": 40.7,
    "speaker": "SPEAKER_02",
    "compression": 0.73,
    "kept": true,
    "text": "I'm the one banged up!"
   },
   {
    "start": 41.08,
    "end": 43.74,
    "speaker": "SPEAKER_00",
    "compression": 1.01,
    "kept": true,
    "text": "No, do you need to pull yourself together or you're gonna get sectioned?"
   },
   {
    "start": 43.74,
    "end": 49.76,
    "speaker": "SPEAKER_00",
    "compression": 1.18,
    "kept": true,
    "text": "Well, you're lousy now, the nayship will also pay you carry on like this, and you'll end up in a padded circle."
   },
   {
    "start": 50.64,
    "end": 51.44,
    "speaker": "SPEAKER_02",
    "compression": 0.69,
    "kept": true,
    "text": "You don't know me?"
   },
   {
    "start": 51.7,
    "end": 52.18,
    "speaker": "SPEAKER_00",
    "compression": 0.27,
    "kept": true,
    "text": "No."
   },
   {
    "start": 53.7,
    "end": 54.22,
    "speaker": "SPEAKER_00",
    "compression": 0.53,
    "kept": true,
    "text": "Maybe no."
   },
   {
    "start": 55.4,
    "end": 57.36,
    "speaker": "SPEAKER_00",
    "compression": 0.79,
    "kept": true,
    "text": "I did not summon very like you."
   },
   {
    "start": 59.64,
    "end": 59.98,
    "speaker": "SPEAKER_00",
    "compression": 0.56,
    "kept": true,
    "text": "My mother."
   }
  ]
 },
 "movie_dialogue_0f39OWEqJ24_1680s": {
  "kind": "speech",
  "speaker_turns": 17,
  "speech_seconds_diarized": 42.0,
  "utterances_before": 24,
  "utterances_after": 24,
