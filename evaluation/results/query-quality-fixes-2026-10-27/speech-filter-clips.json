  },
  "utterances": [
   {
    "start": 0.9,
    "end": 3.28,
    "speaker": "SPEAKER_00",
    "compression": 0.84,
    "kept": true,
    "text": "Oh, there I hope you're certain."
   },
   {
    "start": 5.3,
    "end": 6.12,
    "speaker": "SPEAKER_00",
    "compression": 0.67,
    "kept": true,
    "text": "You do funerals."
   },
   {
    "start": 6.52,
    "end": 7.46,
    "speaker": "SPEAKER_00",
    "compression": 0.58,
    "kept": true,
    "text": "Oh, my yes."
   },
   {
    "start": 7.98,
    "end": 9.66,
    "speaker": "SPEAKER_00",
    "compression": 0.88,
    "kept": true,
    "text": "Will feature great at Heavens Gate."
   },
   {
    "start": 10.04,
    "end": 11.34,
    "speaker": "SPEAKER_00",
    "compression": 0.8,
    "kept": true,
    "text": "That's been a lot over the years."
   },
   {
    "start": 11.96,
    "end": 12.78,
    "speaker": "SPEAKER_00",
    "compression": 0.58,
    "kept": true,
    "text": "Oh, my yes."
   },
   {
    "start": 14.34,
    "end": 14.76,
    "speaker": "SPEAKER_01",
    "compression": 0.53,
    "kept": true,
    "text": "How much?"
   },
   {
    "start": 14.76,
    "end": 16.28,
    "speaker": "SPEAKER_00",
    "compression": 0.8,
    "kept": true,
    "text": "How much? Well, that's difficult."
   },
   {
    "start": 16.74,
    "end": 20.0,
    "speaker": "SPEAKER_00",
    "compression": 0.89,
    "kept": true,
    "text": "But we have caskets for us at less $200, yes, 200."
   },
   {
    "start": 21.08,
    "end": 21.94,
    "speaker": "SPEAKER_01",
    "compression": 0.73,
    "kept": true,
    "text": "How much for this one?"
   },
   {
    "start": 22.02,
    "end": 24.48,
    "speaker": "SPEAKER_00",
    "compression": 0.7,
    "kept": true,
    "text": "Ah, well, that's..."
   },
   {
    "start": 24.48,
    "end": 26.0,
    "speaker": "SPEAKER_00",
    "compression": 0.79,
    "kept": true,
    "text": "Brushed goal will be expensive."
   },
   {
    "start": 26.62,
    "end": 30.22,
    "speaker": "SPEAKER_00",
    "compression": 0.82,
    "kept": true,
    "text": "We have a lovely imitation, mahogany."
   },
   {
    "start": 30.24,
    "end": 33.0,
    "speaker": "SPEAKER_00",
    "compression": 0.47,
    "kept": true,
    "text": "$1,500."
   },
   {
    "start": 34.38,
    "end": 35.96,
    "speaker": "SPEAKER_00",
    "compression": 0.77,
    "kept": true,
    "text": "Well, maybe I could have..."
   },
   {
    "start": 35.96,
    "end": 38.72,
    "speaker": "SPEAKER_00",
    "compression": 0.95,
    "kept": true,
    "text": "I could have used you in something a little less extravagant."
   },
   {
    "start": 42.96,
    "end": 44.1,
    "speaker": "SPEAKER_00",
    "compression": 0.67,
    "kept": true,
    "text": "I want the best."
   },
   {
