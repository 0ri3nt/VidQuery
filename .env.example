# Persistent application data
DATA_DIR=data/app
UPLOAD_DIR=data/app/uploads
GENERATED_DIR=data/app/generated
DATABASE_PATH=data/app/vidquery.sqlite3

# Optional Neo4j mirror (local search remains available when disabled)
ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Local models. Pyannote is part of the normal audio-bearing upload pipeline.
ENABLE_YOLO=true
ENABLE_WHISPER=true
ENABLE_DIARIZATION=true
REQUIRE_DIARIZATION=true
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
PYANNOTE_CACHE_DIR=data/app/models/pyannote
DIARIZATION_DEVICE=auto
ALLOW_MODEL_DOWNLOADS=false
# Use already cached Hugging Face/Pyannote artifacts during normal processing.
# Set to 0 only for the initial explicitly authorized model download.
HF_HUB_OFFLINE=1
ENABLE_LEARNED_ACTIONS=false
ENABLE_GNN_ACTIONS=false
ACTION_MODEL_CHECKPOINT=data/app/models/action_classifier/action_model.pt
ACTION_MODEL_METADATA=data/app/models/action_classifier/action_model.metadata.json
GNN_CHECKPOINT=data/app/models/ava80_scaling/30/ablations/ava80-gat-v5-scale30-roi-frame.pt
GNN_METADATA=data/app/models/ava80_scaling/30/ablations/ava80-gat-v5-scale30-roi-frame.metadata.json
GNN_DEVICE=auto
GNN_MODEL_VERSION=ava80-gat-v5-scale30-roi-frame
GNN_FEATURE_CACHE_DIR=data/app/models/ava80_improved
ENABLE_RELATION_GNN=true
RELATION_GNN_CHECKPOINT=data/app/models/vidor_relation_pair_visual/vidor-relation-pair-visual-gat-v2.pt
RELATION_GNN_METADATA=data/app/models/vidor_relation_pair_visual/vidor-relation-pair-visual-gat-v2.metadata.json
RELATION_GNN_DEVICE=auto
RELATION_GNN_MODEL_VERSION=vidor-relation-pair-visual-gat-v2
SEMANTIC_RETRIEVAL_MODE=sentence_transformer
SEMANTIC_MIN_SIMILARITY=0.20
CONTAINER_SEMANTIC_RETRIEVAL_MODE=hashing
SENTENCE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_EMBEDDING_DEVICE=auto
SENTENCE_EMBEDDING_CACHE_DIR=data/app/models/sentence_transformers

# Optional grounded answer synthesis. GROQ_API_KEY must be supplied only through
# the runtime environment; never commit a real value.
ENABLE_RAG_GENERATION=true
RAG_PROVIDER=groq
RAG_MODEL=openai/gpt-oss-20b
RAG_TOP_K=5
RAG_MIN_EVIDENCE_SCORE=0.20
RAG_TIMEOUT_SECONDS=15
ENABLE_QUERY_PLANNER=true
QUERY_PLANNER_MODEL=openai/gpt-oss-20b
QUERY_PLANNER_MIN_CONFIDENCE=0.70
QUERY_PLANNER_TIMEOUT_SECONDS=10
GROQ_API_KEY=
ENABLE_OCR=true
OCR_DEVICE=auto
OCR_MODEL_DIR=data/app/models/easyocr
OCR_MIN_CONFIDENCE=0.25
OCR_DEDUP_SIMILARITY=0.90
ENABLE_APPEARANCE_FEATURES=true
APPEARANCE_MODEL=ViT-B-32:openai
APPEARANCE_DEVICE=auto
APPEARANCE_MIN_SIMILARITY=0.20
ATTRIBUTE_MIN_CONFIDENCE=0.45
APPEARANCE_CACHE_DIR=data/app/models/appearance
APPEARANCE_MAX_OBSERVATIONS=6
YOLO_MODEL=yolov8n.pt
WHISPER_MODEL=tiny
WHISPER_CACHE_DIR=data/app/models/whisper
HUGGINGFACE_TOKEN=
DEVICE=auto

# Processing and API policy
FRAME_SAMPLE_RATE=1.0
SEGMENT_DURATION=5.0
DETECTION_CONFIDENCE=0.25
DETECTION_IOU=0.45
NEAR_THRESHOLD=0.22
ENABLE_TEMPORAL_TRACKING=true
TRACK_IOU_THRESHOLD=0.30
TRACK_CENTROID_THRESHOLD=0.15
TRACK_MAX_GAP_SECONDS=1.50
RELATIONSHIP_SMOOTHING_GAP_SECONDS=1.50
MAX_UPLOAD_SIZE=2147483648
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BACKEND_PORT=8000
