# Persistent application data
DATA_DIR=data/app
UPLOAD_DIR=data/app/uploads
GENERATED_DIR=data/app/generated
DATABASE_PATH=data/app/vidquery.sqlite3

# Optional Neo4j mirror (local search remains available when disabled)
ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Local models. Pyannote is part of the normal audio-bearing upload pipeline.
ENABLE_YOLO=true
ENABLE_WHISPER=true
ENABLE_DIARIZATION=true
REQUIRE_DIARIZATION=true
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
PYANNOTE_CACHE_DIR=data/app/models/pyannote
DIARIZATION_DEVICE=auto
ALLOW_MODEL_DOWNLOADS=false
# Use already cached Hugging Face/Pyannote artifacts during normal processing.
# Set to 0 only for the initial explicitly authorized model download.
HF_HUB_OFFLINE=1
ENABLE_LEARNED_ACTIONS=false
ENABLE_GNN_ACTIONS=false
ACTION_MODEL_CHECKPOINT=data/app/models/action_classifier/action_model.pt
ACTION_MODEL_METADATA=data/app/models/action_classifier/action_model.metadata.json
GNN_CHECKPOINT=data/app/models/ava80_scale100/ava80-gat-v8-noleak-scale100-lr0.0003.pt
GNN_METADATA=data/app/models/ava80_scale100/ava80-gat-v8-noleak-scale100-lr0.0003.metadata.json
GNN_DEVICE=auto
GNN_MODEL_VERSION=ava80-gat-v8-noleak-scale100-lr0.0003
GNN_FEATURE_CACHE_DIR=data/app/models/ava80_improved
ENABLE_RELATION_GNN=true
RELATION_GNN_CHECKPOINT=data/app/models/vidor_relation_scale2000/vidor-relation-pair-visual-gat-v4-scale2000.pt
RELATION_GNN_METADATA=data/app/models/vidor_relation_scale2000/vidor-relation-pair-visual-gat-v4-scale2000.metadata.json
RELATION_GNN_DEVICE=auto
RELATION_GNN_MODEL_VERSION=vidor-relation-pair-visual-gat-v4-scale2000
# Active since 26 Oct 2026: AVA gat-v8-noleak-scale100 (94 training videos) and VidOR
# gat-v4-scale2000 (1,900 training videos); see docs/EXPERIMENTS_2026-10-26.md. Previous:
# AVA ava80_scaling/30/ablations/ava80-gat-v5-scale30-roi-frame,
# VidOR vidor_relation_pair_visual/...-gat-v2 and vidor_relation_scale500/...-gat-v3-scale500.
SEMANTIC_RETRIEVAL_MODE=sentence_transformer
SEMANTIC_MIN_SIMILARITY=0.20
CONTAINER_SEMANTIC_RETRIEVAL_MODE=hashing
SENTENCE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_EMBEDDING_DEVICE=auto
SENTENCE_EMBEDDING_CACHE_DIR=data/app/models/sentence_transformers

# Optional grounded answer synthesis. GROQ_API_KEY must be supplied only through
# the runtime environment; never commit a real value.
ENABLE_RAG_GENERATION=true
RAG_PROVIDER=groq
RAG_MODEL=openai/gpt-oss-20b
RAG_TOP_K=5
RAG_MIN_EVIDENCE_SCORE=0.20
RAG_TIMEOUT_SECONDS=15
ENABLE_QUERY_PLANNER=true
QUERY_PLANNER_MODEL=openai/gpt-oss-20b
QUERY_PLANNER_MIN_CONFIDENCE=0.70
QUERY_PLANNER_TIMEOUT_SECONDS=10
RELIABILITY_PRIORS_PATH=
ENABLE_PHONETIC_MATCH=false
PHONETIC_MATCH_THRESHOLD=0.75
ENABLE_FRAME_SEMANTIC_RETRIEVAL=false
FRAME_SEMANTIC_WEIGHT=1.0
FRAME_SEMANTIC_FLOOR=0.18
FRAME_SEMANTIC_CEILING=0.32
SOFT_CONSTRAINT_MATCHING=false
# With soft constraints, count missing parsed objects/actions/relations as zero evidence
# in the verdict (ranking unchanged). See docs/QUERY_QUALITY_FIXES_2026-10-27.md.
UNMATCHED_CONSTRAINT_EVIDENCE=false
GROQ_API_KEY=
ENABLE_OCR=true
OCR_DEVICE=auto
OCR_MODEL_DIR=data/app/models/easyocr
OCR_MIN_CONFIDENCE=0.25
OCR_DEDUP_SIMILARITY=0.90
ENABLE_APPEARANCE_FEATURES=true
APPEARANCE_MODEL=ViT-B-32:openai
APPEARANCE_DEVICE=auto
APPEARANCE_MIN_SIMILARITY=0.20
ATTRIBUTE_MIN_CONFIDENCE=0.45
APPEARANCE_CACHE_DIR=data/app/models/appearance
APPEARANCE_MAX_OBSERVATIONS=6
YOLO_MODEL=data/app/models/yolo/yolov8n.pt
WHISPER_MODEL=tiny
WHISPER_CACHE_DIR=data/app/models/whisper
HUGGINGFACE_TOKEN=
DEVICE=auto

# Review-2: ambiguity-aware planning, evidence confidence, timestamp localization
# Posterior margin below which the UI is asked to disambiguate instead of guessing.
HYPOTHESIS_RESOLUTION_MARGIN=0.25
# Fused evidence confidence cut-offs for supported / weak / insufficient verdicts.
EVIDENCE_SUPPORTED_THRESHOLD=0.45
EVIDENCE_WEAK_THRESHOLD=0.15
# Store Whisper word timings so speech queries localize to the word, not the utterance.
WHISPER_WORD_TIMESTAMPS=true
# false = greedy temperature-0 decoding, so re-indexing gives the same transcript.
# true = Whisper's default retry at temperatures 0.2-1.0 with sampling (not reproducible).
WHISPER_TEMPERATURE_FALLBACK=false
# Drop Whisper utterances that are not speech (no diarized speech, no words, or looping
# text) before indexing. Applies when videos are (re)processed.
TRANSCRIPT_SPEECH_FILTER=false
# Hand-labelled challenge manifest written by the Annotate tab.
CHALLENGE_MANIFEST_PATH=evaluation/queries_challenge.json

# Processing and API policy
FRAME_SAMPLE_RATE=1.0
SEGMENT_DURATION=5.0
DETECTION_CONFIDENCE=0.25
DETECTION_IOU=0.45
NEAR_THRESHOLD=0.22
ENABLE_TEMPORAL_TRACKING=true
TRACK_IOU_THRESHOLD=0.30
TRACK_CENTROID_THRESHOLD=0.15
TRACK_MAX_GAP_SECONDS=1.50
RELATIONSHIP_SMOOTHING_GAP_SECONDS=1.50
MAX_UPLOAD_SIZE=2147483648
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BACKEND_PORT=8000
